reg add "%REGKEY%" /v "%NAME1% (TrueType)" /t REG_SZ /d "B074000D.TTF" /f >nul
reg add "%REGKEY%" /v "%NAME2% (TrueType)" /t REG_SZ /d "G034000D.TTF" /f >nul

echo Anunt Windows ca s-au schimbat fonturile ...
powershell -NoProfile -Command ^
  "Add-Type -MemberDefinition '[DllImport(\"user32.dll\", CharSet=CharSet.Auto)] public static extern int SendMessageTimeout(IntPtr hWnd, uint Msg, IntPtr wParam, string lParam, uint fuFlags, uint uTimeout, out IntPtr lpdwResult);' -Name Win32SendMessage -Namespace Win32Functions; $HWND_BROADCAST=[IntPtr]0xffff; $WM_FONTCHANGE=0x001D; $res=[IntPtr]::Zero; [Win32Functions.Win32SendMessage]::SendMessageTimeout($HWND_BROADCAST,$WM_FONTCHANGE,[IntPtr]::Zero,$null,2,5000,[ref]$res) | Out-Null"

del /f /q "%TMP1%" "%TMP2%" "%OUT1%" "%OUT2%" >nul 2>&1

echo.
echo === GATA. Fonturile "%NAME1%" si "%NAME2%" sunt instalate. ===
