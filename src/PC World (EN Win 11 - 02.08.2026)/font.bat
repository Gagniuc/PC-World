    goto :eof_err
)
if not exist "%OUT2%" (
    echo [EROARE] Decodarea GlaserSteD a esuat.
    goto :eof_err
)

echo Copiez fonturile in %WINFONTS% ...
copy /y "%OUT1%" "%WINFONTS%\B074000D.TTF" >nul
copy /y "%OUT2%" "%WINFONTS%\G034000D.TTF" >nul

